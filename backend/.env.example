# =====================================================
# Resume Generator Backend — Environment Variables
# =====================================================
# Copy this file to .env and fill in real values for your
# environment. NEVER commit a populated .env to Git.

# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed origins for CORS.
# Use "*" only in trusted internal environments.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Trust X-Forwarded-* headers (set when running behind a proxy)
TRUST_PROXY=false
# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# ---- AI (Groq) ----
# Leave GROQ_API_KEY blank to run in deterministic "offline" mode
# using the built-in heuristic extractor. The system will keep
# working without a key — perfect for dev / CI / smoke tests.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Hard cap for AI requests (milliseconds)
AI_TIMEOUT_MS=60000

# ---- Storage ----
# STORAGE=memory (default) keeps everything in process — fine for
# dev and tests. STORAGE=firebase routes persistence through the
# Firebase Admin SDK (Firestore).
STORAGE=memory

# ---- Firebase (only required when STORAGE=firebase) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Raw private key (newlines escaped as \n). Example:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ---- Auth ----
# AUTH_MODE controls how the optional auth middleware behaves.
#   - "off"          : no auth required (dev only)
#   - "optional"     : verify Firebase ID token if present, attach req.user
#   - "required"     : reject all requests without a valid Firebase ID token
AUTH_MODE=off
# When AUTH_MODE=required, allow requests with this header to bypass
# auth — useful for local cron / smoke tests. Never enable in prod.
AUTH_DEV_BYPASS_HEADER=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Logging ----
LOG_LEVEL=info
