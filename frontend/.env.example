# Where the backend lives. Empty = same-origin (recommended for Vercel deploys
# where frontend and /api share one host). Set this for split deployments.
# VITE_API_BASE_URL=http://localhost:5000

# Firebase Web SDK config. Pull these from the Firebase Console:
#   Project Settings → General → Your apps → Web app → SDK setup → Config
# All six are required for auth + Firestore to initialise.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
